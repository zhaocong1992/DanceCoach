# 统一行尾，避免跨平台 diff 噪音
* text=auto eol=lf

# 脚本按平台区分
gradlew        text eol=lf
gradlew.bat    text eol=crlf
*.sh           text eol=lf
*.bat          text eol=crlf

# 二进制文件不做换行转换
*.png          binary
*.jpg          binary
*.jpeg         binary
*.jar          binary
*.apk          binary
*.jks          binary
*.keystore     binary
