<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="返回"
            android:tint="@color/textPrimary"
            android:rotation="180" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="动作预审" />

        <TextView
            android:id="@+id/btnRename"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:background="@drawable/import_btn_bg"
            android:textColor="@color/textPrimary"
            android:textSize="13sp"
            android:text="重命名" />

        <TextView
            android:id="@+id/btnReanalyze"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:background="@drawable/import_btn_bg"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:text="重新分析" />

        <TextView
            android:id="@+id/btnShare"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:background="@drawable/market_fab_bg"
            android:textColor="@color/bg"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="分享到市场"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnSaveToLibrary"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:background="@drawable/import_btn_bg"
            android:textColor="@color/success"
            android:textSize="13sp"
            android:text="保存到库"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 左侧：原视频 + 右侧：识别动作（分屏显示） -->
    <LinearLayout
        android:id="@+id/videoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_margin="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/timelineLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/metricsPanel">

        <!-- 左：原视频 -->
        <FrameLayout
            android:id="@+id/videoPane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/library_card_bg">

            <VideoView
                android:id="@+id/videoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="#66000000"
                android:textColor="@color/textSecondary"
                android:textSize="11sp"
                android:text="原视频" />

            <!-- 播放/暂停按钮 -->
            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                android:tint="#CCFFFFFF"
                android:background="@drawable/play_btn_bg"
                android:contentDescription="播放/暂停"
                android:visibility="visible" />

            <!-- 分析中遮罩 -->
            <LinearLayout
                android:id="@+id/analyzingOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminateTint="@color/accent" />

                <TextView
                    android:id="@+id/analyzingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:text="分析中..." />
            </LinearLayout>
        </FrameLayout>

        <!-- 右：识别动作骨架（独立显示） -->
        <FrameLayout
            android:id="@+id/skeletonPane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@drawable/library_card_bg">

            <com.dancecoach.app.ui.SkeletonOverlayView
                android:id="@+id/skeletonOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="#66000000"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:text="识别动作" />

            <!-- 未检测到人时的提示 -->
            <TextView
                android:id="@+id/noPoseHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:textColor="@color/textSecondary"
                android:textSize="11sp"
                android:text="未检测到人体"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 时间轴 -->
    <LinearLayout
        android:id="@+id/timelineLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/metricsPanel">

        <SeekBar
            android:id="@+id/timeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <TextView
            android:id="@+id/timeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textSecondary"
            android:textSize="11sp"
            android:text="0:00 / 0:00" />
    </LinearLayout>

    <!-- 右侧：指标面板 -->
    <LinearLayout
        android:id="@+id/metricsPanel"
        android:layout_width="280dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/library_card_bg"
        android:layout_margin="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textSecondary"
            android:textSize="13sp"
            android:text="动作质量评估" />

        <!-- 质量总分 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/qualityScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="36sp"
                android:textStyle="bold"
                android:text="--" />

            <TextView
                android:id="@+id/qualityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/textSecondary"
                android:textSize="14sp"
                android:text="未分析" />
        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#22FFFFFF" />

        <!-- 检测率 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:text="检测率" />

            <TextView
                android:id="@+id/detectionRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:text="--" />
        </LinearLayout>

        <!-- 平均置信度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:text="平均置信度" />

            <TextView
                android:id="@+id/avgConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:text="--" />
        </LinearLayout>

        <!-- 有效帧数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:text="有效帧数" />

            <TextView
                android:id="@+id/validFrames"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:text="--" />
        </LinearLayout>

        <!-- 分段数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:text="分段数" />

            <TextView
                android:id="@+id/segmentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:text="--" />
        </LinearLayout>

        <!-- 难度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:text="难度" />

            <TextView
                android:id="@+id/difficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:text="--" />
        </LinearLayout>

        <!-- 分析进度条 -->
        <ProgressBar
            android:id="@+id/analysisProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_bg"
            android:visibility="gone" />

        <!-- 提示消息 -->
        <TextView
            android:id="@+id/messageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/import_btn_bg"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="开始练习" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:background="@drawable/import_btn_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/failure"
                    android:textSize="14sp"
                    android:text="删除" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
