<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/library_card_bg"
    android:padding="8dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp">

    <!-- 缩略图 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="90dp">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#22000000"
            android:contentDescription="缩略图" />

        <!-- 时长标签 -->
        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="#AA000000"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:text="0:00" />

        <!-- 状态徽标 -->
        <TextView
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="@drawable/status_badge_bg"
            android:textColor="@color/success"
            android:textSize="10sp"
            android:text="待审"
            android:visibility="gone" />

        <!-- 分析进度条 -->
        <ProgressBar
            android:id="@+id/analysisProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_bg"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 名称 -->
    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/textPrimary"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="视频名称" />

    <!-- 分数 + 状态文字 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textSecondary"
            android:textSize="11sp"
            android:text="" />
    </LinearLayout>

    <!-- 删除按钮 -->
    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:background="@drawable/delete_btn_bg"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:text="删除" />

</LinearLayout>
